<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%" fill="none">
  <!-- Clean White Circular Canvas Base -->
  <rect width="500" height="500" fill="#ffffff" />

  <!-- Speed Line trailing behind -->
  <line x1="80" y1="135" x2="270" y2="135" stroke="#222222" stroke-width="2.5" stroke-linecap="round" />

  <!-- Rear Wheel (Left) -->
  <circle cx="206" cy="350" r="30" fill="#1f2328" />
  <circle cx="206" cy="350" r="21" fill="#cbd5e1" />
  <circle cx="206" cy="350" r="11" fill="#f8fafc" />
  <circle cx="206" cy="350" r="4" fill="#1f2328" />

  <!-- Front Wheel (Right) -->
  <circle cx="380" cy="346" r="30" fill="#1f2328" />
  <circle cx="380" cy="346" r="21" fill="#cbd5e1" />
  <circle cx="380" cy="346" r="11" fill="#f8fafc" />
  <circle cx="380" cy="346" r="4" fill="#1f2328" />

  <!-- Yellow Scooter Chassis & Belly Pan -->
  <path d="M 190 340 C 190 300, 220 280, 265 280 L 330 280 C 350 280, 360 305, 360 335 L 190 340 Z" fill="#ffdb3b" />

  <!-- Yellow Scooter Rear Body & Mudguard -->
  <path d="M 150 335 C 150 290, 180 275, 235 275 L 285 275 C 270 325, 240 350, 206 350 C 170 350, 150 345, 150 335 Z" fill="#ffdb3b" />

  <!-- Rear Orange Tail Reflector -->
  <circle cx="166" cy="305" r="5" fill="#f97316" />

  <!-- Delivery Boxes on Rear Luggage Rack -->
  <!-- Top Yellow / Orange Parcel -->
  <rect x="178" y="215" width="52" height="15" rx="2" fill="#f59e0b" />
  <!-- Bottom Navy Blue Cargo Box -->
  <rect x="172" y="230" width="62" height="45" rx="3" fill="#334e68" />

  <!-- Scooter Black Seat -->
  <path d="M 235 245 C 235 245, 252 275, 290 275 C 290 268, 278 250, 248 245 Z" fill="#181e24" />

  <!-- Front Shield & Handlebar Column (Yellow) -->
  <path d="M 320 340 C 330 340, 345 315, 350 290 C 360 250, 355 235, 345 228 C 338 224, 332 228, 328 238 L 322 268 C 316 298, 302 338, 320 340 Z" fill="#ffdb3b" />
  <path d="M 345 285 L 380 346 L 370 350 L 335 295 Z" fill="#ffdb3b" />
  <!-- Front Wheel Mudguard (Yellow) -->
  <path d="M 358 320 C 368 312, 394 312, 410 328 C 394 325, 374 325, 358 320 Z" fill="#ffdb3b" />

  <!-- Headlamp Console (Cream / Light Yellow) -->
  <circle cx="352" cy="237" r="7" fill="#fef9c3" stroke="#ffdb3b" stroke-width="2" />

  <!-- Rider Body -->
  <!-- Legs (Navy Blue Jeans) -->
  <path d="M 248 270 C 272 270, 308 280, 324 305 L 310 338 C 300 338, 292 318, 282 300 L 265 292 Z" fill="#334e68" />
  <!-- Shoes (Grey sneakers with white soles) -->
  <path d="M 302 338 L 320 338 C 320 342, 306 342, 300 341 Z" fill="#cbd5e1" />
  <path d="M 300 341 L 320 341 C 320 343, 300 343, 300 341 Z" fill="#ffffff" />

  <!-- Rider Yellow Jacket / Hoodie -->
  <path d="M 240 225 C 250 200, 290 185, 310 185 C 320 198, 318 218, 304 240 C 278 240, 252 240, 240 225 Z" fill="#ffdb3b" />
  <!-- Arm Reaching to Handlebars -->
  <path d="M 295 205 C 310 212, 330 232, 340 242 L 330 248 C 320 238, 304 222, 290 215 Z" fill="#ffdb3b" />
  <!-- Black Handlebar Grip / Glove -->
  <circle cx="338" cy="242" r="4.5" fill="#181e24" />

  <!-- Rider Neck -->
  <path d="M 300 185 L 314 185 L 310 198 L 300 195 Z" fill="#fed7aa" />

  <!-- Helmet (Bright Yellow with Visor) -->
  <!-- Main Yellow Helmet Dome -->
  <path d="M 296 170 C 296 126, 355 120, 368 155 C 372 165, 365 195, 344 205 C 320 215, 296 198, 296 170 Z" fill="#ffdb3b" />
  <!-- White Visor with Reflection -->
  <path d="M 328 152 C 342 152, 360 162, 364 180 L 344 194 C 332 176, 328 162, 328 152 Z" fill="#ffffff" />
</svg>
