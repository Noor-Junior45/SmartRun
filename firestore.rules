rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mdhassan1738@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128
        && data.customerName is string && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() <= 25
        && data.totalAmount is number && data.totalAmount >= 0;
    }

    function isValidBooking(data) {
      return data.customerName is string && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() <= 25;
    }

    // Connection Health Check
    match /test/{testDoc} {
      allow read: if true;
    }

    // Public Product Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Quick-Commerce Orders
    match /orders/{orderId} {
      // Secure access: only the owner or an admin can read an order
      allow get: if isOwner(resource.data.userId) || isOwner(resource.data.user_id) || isAdmin();
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      // Validated creation with ownership binding
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && (!isSignedIn() || incoming().userId == request.auth.uid || incoming().user_id == request.auth.uid);
      // Non-admins can only cancel/update status of their own order
      allow update: if isValidId(orderId) && (
        isAdmin() || (
          (isOwner(resource.data.userId) || isOwner(resource.data.user_id))
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'notes', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Real Estate & Apartment Wiring Service Bookings
    match /services_bookings/{bookingId} {
      // Only the booking owner or admin can read
      allow get: if isOwner(resource.data.userId) || isOwner(resource.data.user_id) || isAdmin();
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && (!isSignedIn() || incoming().userId == request.auth.uid || incoming().user_id == request.auth.uid);
      allow update: if isValidId(bookingId) && (
        isAdmin() || (
          (isOwner(resource.data.userId) || isOwner(resource.data.user_id))
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isValidId(userId);
      allow list: if isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin() || isValidId(userId)) && isValidId(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Phone Lookup Index for Identity Resolution
    match /users_by_phone/{phone} {
      allow read, write: if isValidId(phone);
    }

    // Phone OTP Verification Tracking
    match /phone_otps/{phone} {
      allow read, write: if isValidId(phone);
    }

    // Saved Addresses
    match /user_addresses/{addressId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(addressId)
        && (incoming().user_id == request.auth.uid || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(addressId)
        && (existing().user_id == request.auth.uid || existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(addressId)
        && (existing().user_id == request.auth.uid || existing().userId == request.auth.uid || isAdmin());
    }

    // Saved UPI Handles
    match /user_upi/{upiId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(upiId)
        && (incoming().user_id == request.auth.uid || incoming().userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(upiId)
        && (existing().user_id == request.auth.uid || existing().userId == request.auth.uid || isAdmin());
    }
  }
}
